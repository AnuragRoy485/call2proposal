# Copy to .env for local runs, or set in Render's dashboard for deploys.
# Leave LLM_PROVIDER unset to run the deterministic demo provider (no key needed).
LLM_PROVIDER=openai          # openai | anthropic | gemini
LLM_API_KEY=sk-...
# LLM_MODEL=               # optional override; defaults: gpt-4o-mini, claude-haiku-4-5, gemini-2.5-flash
